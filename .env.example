# URL canonique du site, utilisée pour les balises canonical, le sitemap et l'Open Graph.
SITE_URL=https://www.blattis.fr

# Point de destination du formulaire de contact.
# Sans valeur, le formulaire pointe vers /merci et n'envoie rien : il faut brancher
# un service de traitement (Formspree, Netlify Forms, fonction serverless...) avant
# la mise en ligne.
FORM_ENDPOINT=
