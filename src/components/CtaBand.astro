---
import { site, cta } from '../data/site';
export interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  variant?: 'bordeaux' | 'creme';
}
const {
  title = 'Une présence de cafards à faire évaluer ?',
  text = "Décrivez la situation : les pièces concernées, la fréquence des observations, le type de bâtiment. Cet échange permet de préparer une intervention adaptée plutôt qu'un traitement standard.",
  primaryLabel = cta.primary,
  variant = 'bordeaux',
} = Astro.props;
---
<section class={`ctab ctab--${variant}`}>
  <div class="wrap ctab__inner">
    <div class="ctab__text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="ctab__actions">
      <a href="/contact" class="btn btn--primary">{primaryLabel}</a>
      <a href={site.phoneHref} class={variant === 'bordeaux' ? 'btn btn--on-dark' : 'btn btn--ghost'}>
        {cta.call}
      </a>
    </div>
  </div>
</section>
<style>
  .ctab { border-block: 1px solid var(--line-soft); }
  .ctab--bordeaux {
    background: var(--bx-800);
    background-image:
      radial-gradient(620px 340px at 88% 110%, rgba(199, 123, 69, 0.22), transparent 62%),
      radial-gradient(520px 300px at 6% -20%, rgba(255, 253, 248, 0.07), transparent 60%);
    border-color: transparent;
  }
  .ctab--creme { background: var(--creme-2); }
  .ctab__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(2.5rem, 4.5vw, 3.75rem);
  }
  .ctab__text { max-width: 58ch; }
  .ctab h2 { font-size: clamp(1.4rem, 1.15rem + 1.1vw, 1.95rem); margin-bottom: 0.55rem; }
  .ctab--bordeaux h2 { color: var(--ivoire); }
  .ctab p { margin: 0; font-size: 1.02rem; line-height: 1.6; }
  .ctab--bordeaux p { color: rgba(246, 240, 230, 0.82); }
  .ctab--creme p { color: var(--ink-soft); }
  .ctab__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  @media (max-width: 820px) { .ctab__actions { width: 100%; } .ctab__actions .btn { flex: 1 1 200px; } }
</style>
