---
import Logo from './Logo.astro';
import { site, nav, cta } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="hdr" data-header>
  <div class="hdr__bar wrap">
    <a href="/" class="hdr__logo" aria-label={`${site.brand} — accueil`}>
      <Logo variant="light" />
    </a>

    <nav class="hdr__nav" aria-label="Navigation principale">
      <ul class="hdr__list">
        {nav.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true" focusable="false"><path d="M1 1.2 4.5 4.6 8 1.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="hdr__sub">
                <ul>
                  {item.children.map((child) => (
                    <li><a href={child.href} aria-current={path === child.href ? 'page' : undefined}>{child.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a href={site.phoneHref} class="hdr__tel" data-tel>
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.2 1.8 6.9 5 5.4 6.6c.7 1.6 2 2.9 3.6 3.6l1.6-1.5 3.2 1.7-.5 2.4c-.2.8-.9 1.3-1.7 1.2C6.5 13.4 2.6 9.5 2 3.9c-.1-.8.4-1.5 1.2-1.7l2-.4Z" fill="currentColor"/></svg>
        <span>{site.phoneDisplay}</span>
      </a>
      <a href="/contact" class="btn btn--primary hdr__cta">{cta.primary}</a>
      <button class="hdr__burger" data-burger type="button" aria-expanded="false" aria-controls="nav-mobile" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="navm" id="nav-mobile" hidden>
    <div class="navm__inner wrap">
      <ul class="navm__list">
        {nav.map((item, i) => (
          <li>
            {item.children ? (
              <>
                <button type="button" class="navm__toggle" data-sub-toggle aria-expanded="false" aria-controls={`navm-sub-${i}`}>
                  <span>{item.label}</span>
                  <svg width="11" height="7" viewBox="0 0 11 7" aria-hidden="true" focusable="false"><path d="M1 1.3 5.5 5.5 10 1.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <ul class="navm__sub" id={`navm-sub-${i}`} hidden>
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="navm__link" href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
        <li><a class="navm__link" href="/contact">Contact</a></li>
      </ul>
      <div class="navm__cta">
        <a href="/contact" class="btn btn--primary">{cta.primary}</a>
        <a href={site.phoneHref} class="btn btn--on-dark">{cta.call}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 100;
    background: var(--bx-900);
    border-bottom: 1px solid rgba(255, 253, 248, 0.09);
    transition: box-shadow 0.22s ease, background-color 0.22s ease;
  }
  .hdr.is-scrolled { background: var(--bx-950); box-shadow: 0 6px 26px -14px rgba(46, 8, 16, 0.8); }

  .hdr__bar {
    display: flex; align-items: center; gap: 1.25rem;
    min-height: var(--header-h);
  }
  .hdr__logo { flex: none; display: flex; align-items: center; line-height: 0; }
  .hdr__logo svg { height: 36px; width: auto; }

  .hdr__nav { margin-left: auto; }
  .hdr__list {
    display: flex; align-items: center; gap: 0.15rem;
    list-style: none; margin: 0; padding: 0;
  }
  .hdr__list > li { position: relative; }
  .hdr__list > li > a {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-family: var(--font-display); font-size: 0.855rem; font-weight: 600;
    color: rgba(246, 240, 230, 0.86); text-decoration: none;
    padding: 0.65rem 0.7rem; border-radius: var(--r-sm);
    letter-spacing: -0.004em;
    transition: color 0.16s ease, background-color 0.16s ease;
    white-space: nowrap;
  }
  .hdr__list > li > a:hover { color: var(--ivoire); background: rgba(255, 253, 248, 0.07); }
  .hdr__list > li > a[aria-current='page'] { color: var(--ivoire); }
  .hdr__list > li > a[aria-current='page']::after {
    content: ''; position: absolute; left: 0.7rem; right: 0.7rem; bottom: -1px;
    height: 2px; background: var(--cuivre); border-radius: 2px;
  }
  .hdr__list svg { opacity: 0.6; transition: transform 0.18s ease; }
  .has-sub:hover svg, .has-sub:focus-within svg { transform: rotate(180deg); }

  .hdr__sub {
    position: absolute; top: calc(100% + 6px); left: 0;
    min-width: 254px; padding: 0.4rem;
    background: var(--ivoire);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    box-shadow: 0 22px 48px -24px rgba(46, 8, 16, 0.5);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .has-sub:hover .hdr__sub, .has-sub:focus-within .hdr__sub { opacity: 1; visibility: visible; transform: none; }
  .hdr__sub ul { list-style: none; margin: 0; padding: 0; }
  .hdr__sub a {
    display: block; padding: 0.55rem 0.8rem; border-radius: var(--r-sm);
    font-size: 0.925rem; color: var(--ink-soft); text-decoration: none;
  }
  .hdr__sub a:hover { background: var(--creme-2); color: var(--bx-800); }
  .hdr__sub a[aria-current='page'] { color: var(--bx-800); font-weight: 600; }

  .hdr__actions { display: flex; align-items: center; gap: 0.7rem; flex: none; }
  .hdr__tel {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-display); font-size: 0.875rem; font-weight: 600;
    color: var(--creme); text-decoration: none; white-space: nowrap;
    padding: 0.5rem 0.25rem;
  }
  .hdr__tel:hover { color: var(--cuivre); }
  .hdr__tel svg { color: var(--cuivre); flex: none; }
  .hdr__cta { padding: 0.68rem 1.1rem; font-size: 0.875rem; min-height: 42px; }

  .hdr__burger {
    display: none; flex-direction: column; justify-content: center; gap: 4.5px;
    width: 44px; height: 44px; padding: 0 10px;
    background: transparent; border: 1px solid rgba(255, 253, 248, 0.24);
    border-radius: var(--r); cursor: pointer;
  }
  .hdr__burger span { display: block; height: 1.7px; background: var(--creme); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6.2px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6.2px) rotate(-45deg); }

  /* --- Panneau mobile --- */
  .navm {
    background: var(--bx-950);
    border-top: 1px solid rgba(255, 253, 248, 0.1);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .navm__inner { padding-block: 1rem 1.5rem; }
  .navm__list { list-style: none; margin: 0 0 1.25rem; padding: 0; }
  .navm__list > li { border-bottom: 1px solid rgba(255, 253, 248, 0.08); }
  .navm__link, .navm__toggle {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    width: 100%; padding: 0.95rem 0.15rem;
    font-family: var(--font-display); font-size: 1.0125rem; font-weight: 600;
    color: var(--creme); text-decoration: none;
    background: transparent; border: 0; cursor: pointer; text-align: left;
  }
  .navm__toggle svg { opacity: 0.65; transition: transform 0.2s ease; flex: none; }
  .navm__toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .navm__sub { list-style: none; margin: 0 0 0.85rem; padding: 0 0 0 0.9rem; border-left: 1.5px solid rgba(199, 123, 69, 0.45); }
  .navm__sub a {
    display: block; padding: 0.6rem 0.15rem;
    font-size: 0.97rem; color: rgba(246, 240, 230, 0.8); text-decoration: none;
  }
  .navm__cta { display: grid; gap: 0.65rem; }

  @media (max-width: 1080px) {
    .hdr__nav { display: none; }
    .hdr__actions { margin-left: auto; }
    .hdr__burger { display: flex; }
  }
  @media (max-width: 640px) {
    .hdr__cta { display: none; }
    .hdr__tel span { display: none; }
    .hdr__tel { border: 1px solid rgba(255, 253, 248, 0.24); border-radius: var(--r); width: 44px; height: 44px; justify-content: center; }
    .hdr__logo svg { height: 31px; }
  }
  @media (min-width: 1081px) { .navm { display: none; } }
</style>
