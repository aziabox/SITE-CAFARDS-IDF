---
import mapData from '../data/idf-map.json';
import { departements } from '../data/departements';
import { villes } from '../data/villes';

export interface Props {
  /** Département mis en évidence (slug), pour les pages départementales. */
  active?: string;
  /** Affiche la liste textuelle sous la carte (équivalent accessible et maillage). */
  withList?: boolean;
  title?: string;
}
const { active, withList = true, title = "Carte des zones d'intervention en Île-de-France" } = Astro.props;

const byCode = new Map(departements.map((d) => [d.code, d]));

/**
 * Les quatre départements centraux sont trop proches : leurs étiquettes sont
 * décalées vers l'extérieur pour rester lisibles.
 */
const codeNudge: Record<string, [number, number]> = {
  '75': [3, 3],
  '92': [-34, 12],
  '93': [14, -22],
  '94': [16, 24],
};

const shapes = mapData.departements
  .map((f) => {
    const dep = byCode.get(f.code);
    return dep ? { ...f, dep } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  // Les grands départements d'abord pour que Paris reste cliquable au-dessus.
  .sort((a, b) => b.points - a.points);
---

<div class="map" data-map>
  <div class="map__head">
    <div>
      <p class="eyebrow">Île-de-France</p>
      <h2 class="map__title">Où intervenons-nous ?</h2>
    </div>
    <div class="map__zoom" role="group" aria-label="Zoom de la carte">
      <button type="button" data-zoom="in" aria-label="Agrandir la carte">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <button type="button" data-zoom="out" aria-label="Réduire la carte">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <button type="button" data-zoom="reset" aria-label="Réinitialiser la vue">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M13.6 8a5.6 5.6 0 1 1-1.7-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M13.8 2v2.4h-2.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div class="map__body">
    <div class="map__canvas" data-canvas>
      <svg
        viewBox={mapData.viewBox}
        data-svg
        data-viewbox={mapData.viewBox}
        role="img"
        aria-label={title}
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>{title}</title>
        <g data-pan>
          {shapes.map((s) => (
            <a
              href={`/zones-intervention/${s.dep.slug}`}
              class={`map__dep${active === s.dep.slug ? ' is-active' : ''}`}
              data-dep={s.dep.slug}
              data-nom={s.dep.nom}
              data-code={s.dep.code}
              data-lede={s.dep.lede}
              aria-label={`${s.dep.nom} (${s.dep.code}) — voir la page départementale`}
            >
              <title>{`${s.dep.nom} (${s.dep.code})`}</title>
              <path d={s.d} />
            </a>
          ))}

          <g class="map__labels" aria-hidden="true">
            {mapData.departements.map((f) => {
              const [dx, dy] = codeNudge[f.code] ?? [0, 0];
              return <text x={f.labelX + dx} y={f.labelY + dy} class="map__code">{f.code}</text>;
            })}
          </g>

          {villes.map((v) => (
            <a
              href={`/${v.slug}`}
              class="map__city"
              data-city={v.slug}
              data-nom={v.nom}
              data-dep-nom={v.departementNom}
              aria-label={`${v.nom} — voir la page locale`}
            >
              <title>{v.nom}</title>
              <circle cx={v.mapX} cy={v.mapY} r="18" class="map__city-hit" />
              <circle cx={v.mapX} cy={v.mapY} r="3.6" class="map__city-dot" />
            </a>
          ))}
        </g>
      </svg>
    </div>

    <aside class="map__panel" data-panel aria-live="polite">
      <p class="map__panel-kicker" data-panel-kicker>Département</p>
      <h3 data-panel-title>Île-de-France</h3>
      <p data-panel-text>
        Survolez ou sélectionnez un département pour afficher le contexte local,
        puis accédez à la page correspondante. Les points signalent les villes
        disposant d'une page dédiée.
      </p>
      <a class="btn btn--ghost map__panel-cta" href="/zones-intervention" data-panel-link>
        Voir toutes les zones
      </a>
      <p class="map__hint">Glissez pour déplacer la carte, molette ou boutons pour zoomer.</p>
    </aside>
  </div>

  {/*
    Les points de ville constituent un raccourci visuel. Sur petit écran, leur
    surface de contact reste inférieure à 24 px : la liste textuelle ci-dessous
    (ou la section « villes » de la page hôte) fournit les mêmes liens à taille
    normale, ce qui correspond à l'exception « contrôle équivalent » du critère
    WCAG 2.5.8.
  */}
  {withList && (
    <div class="map__list">
      {departements.map((d) => (
        <div class="map__list-col">
          <h3>
            <a href={`/zones-intervention/${d.slug}`}>{d.nom} <span>({d.code})</span></a>
          </h3>
          {d.cities.length > 0 && (
            <ul>
              {d.cities.map((c) => {
                const v = villes.find((x) => x.slug === c);
                return v ? <li><a href={`/${v.slug}`}>{v.nom}</a></li> : null;
              })}
            </ul>
          )}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .map {
    background: var(--creme-2);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    padding: clamp(1.1rem, 2.5vw, 1.9rem);
  }
  .map__head {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.25rem;
  }
  .map__head .eyebrow { margin-bottom: 0.5rem; }
  .map__title { margin: 0; font-size: clamp(1.35rem, 1.15rem + 0.9vw, 1.85rem); }

  .map__zoom { display: flex; gap: 0.4rem; }
  .map__zoom button {
    width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r);
    color: var(--bx-800); cursor: pointer; transition: border-color 0.16s ease, color 0.16s ease;
  }
  .map__zoom button:hover { border-color: var(--terra); color: var(--terra-600); }
  .map__zoom svg { width: 16px; height: 16px; }

  .map__body {
    display: grid; grid-template-columns: minmax(0, 1.72fr) minmax(240px, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem); align-items: start;
  }

  .map__canvas {
    background: var(--ivoire);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    /* La carte reste dans le HTML (maillage interne et accessibilité) mais n'est
       pas mise en page ni rastérisée tant qu'elle est hors de l'écran. */
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }
  .map__canvas.is-dragging { cursor: grabbing; }
  .map__canvas svg { display: block; width: 100%; height: auto; }

  .map__dep path {
    fill: #EFE3D3;
    stroke: var(--bx-700);
    stroke-width: 2.1;
    stroke-linejoin: round;
    transition: fill 0.16s ease, stroke 0.16s ease;
  }
  .map__dep { cursor: pointer; }
  .map__dep:hover path, .map__dep:focus-visible path { fill: #EBC9B4; stroke: var(--terra-600); stroke-width: 2.6; }
  .map__dep.is-active path { fill: var(--bx-800); stroke: var(--bx-900); }
  .map__dep:focus-visible { outline: none; }
  .map__dep:focus-visible path { stroke-width: 3; stroke: var(--terra); }

  .map__code {
    font-family: var(--font-display); font-size: 21px; font-weight: 700;
    fill: var(--bx-800); fill-opacity: 0.72; text-anchor: middle; pointer-events: none;
    paint-order: stroke; stroke: #FFFDF8; stroke-width: 3.5; stroke-opacity: 0.85;
  }

  .map__city-hit { fill: transparent; }
  .map__city-dot { fill: var(--terra); stroke: var(--ivoire); stroke-width: 1.6; transition: r 0.14s ease; }
  .map__city:hover .map__city-dot, .map__city:focus-visible .map__city-dot { fill: var(--bx-800); r: 5; }
  .map__city:focus-visible { outline: none; }
  .map__city:focus-visible .map__city-hit { fill: rgba(180, 81, 44, 0.28); }

  .map__panel {
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    padding: clamp(1.05rem, 2vw, 1.4rem);
    display: flex; flex-direction: column;
    align-self: start;
  }
  .map__panel-kicker {
    font-family: var(--font-display); font-size: 0.755rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--terra-600);
    margin: 0 0 0.5rem;
  }
  .map__panel h3 { font-size: 1.16rem; margin-bottom: 0.6rem; }
  .map__panel p { font-size: 0.93rem; color: var(--ink-soft); line-height: 1.58; }
  .map__panel-cta { margin-top: 1.25rem; align-self: flex-start; padding: 0.7rem 1.1rem; font-size: 0.875rem; min-height: 44px; }
  .map__hint { margin: 0.9rem 0 0; font-size: 0.815rem; color: var(--ink-muted); }

  .map__list {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.1rem 1.5rem;
    margin-top: clamp(1.25rem, 2.5vw, 1.85rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.6rem);
    border-top: 1px solid var(--line-soft);
  }
  .map__list-col h3 { font-size: 0.95rem; margin-bottom: 0.45rem; }
  .map__list-col h3 a { display: inline-block; padding-block: 4px; text-decoration: none; }
  .map__list-col h3 span { color: var(--ink-muted); font-weight: 400; }
  .map__list-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .map__list-col li a { display: inline-block; padding-block: 3px; font-size: 0.89rem; color: var(--ink-soft); text-decoration: none; }
  .map__list-col li a:hover { color: var(--terra-600); text-decoration: underline; text-underline-offset: 0.2em; }

  @media (max-width: 860px) {
    .map__body { grid-template-columns: 1fr; }
    .map__panel { order: 2; }
  }
</style>

<script>
  // Zoom, déplacement et panneau d'information de la carte.
  // Regroupé par Astro dans un fichier externe : la politique de sécurité du
  // contenu reste en « script-src 'self' », sans 'unsafe-inline'.
  const root = document.querySelector('[data-map]');
  const svg = root?.querySelector('[data-svg]');
  const canvas = root?.querySelector('[data-canvas]');
  const kicker = root?.querySelector('[data-panel-kicker]');
  const pTitle = root?.querySelector('[data-panel-title]');
  const pText = root?.querySelector('[data-panel-text]');
  const pLink = root?.querySelector('[data-panel-link]');

  if (root && svg && canvas instanceof HTMLElement && kicker && pTitle && pText && pLink) {
    const base = (svg.getAttribute('data-viewbox') || '0 0 1000 800').split(' ').map(Number);
    let vb = base.slice();

    /** Recadre la vue dans les limites du cadre initial. */
    const apply = () => {
      const maxW = base[2];
      const maxH = base[3];
      if (vb[2] > maxW) {
        vb[2] = maxW;
        vb[3] = maxH;
      }
      vb[0] = Math.max(base[0], Math.min(vb[0], base[0] + maxW - vb[2]));
      vb[1] = Math.max(base[1], Math.min(vb[1], base[1] + maxH - vb[3]));
      svg.setAttribute('viewBox', vb.join(' '));
    };

    /** Zoome autour d'un point exprimé en fraction de la largeur/hauteur. */
    const zoom = (factor: number, cx = 0.5, cy = 0.5) => {
      let nw = vb[2] / factor;
      let nh = vb[3] / factor;
      const minW = base[2] / 6;
      if (nw > base[2]) {
        nw = base[2];
        nh = base[3];
      }
      if (nw < minW) {
        nw = minW;
        nh = base[3] / 6;
      }
      vb[0] += (vb[2] - nw) * cx;
      vb[1] += (vb[3] - nh) * cy;
      vb[2] = nw;
      vb[3] = nh;
      apply();
    };

    root.querySelectorAll('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-zoom');
        if (k === 'in') zoom(1.45);
        else if (k === 'out') zoom(1 / 1.45);
        else {
          vb = base.slice();
          apply();
        }
      });
    });

    canvas.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && Math.abs(e.deltaY) < 4) return;
        e.preventDefault();
        const r = canvas.getBoundingClientRect();
        zoom(e.deltaY < 0 ? 1.18 : 1 / 1.18, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
      },
      { passive: false },
    );

    // --- Déplacement (souris et tactile) ---
    let drag: { x: number; y: number; vb: number[] } | null = null;

    const startDrag = (x: number, y: number) => {
      drag = { x, y, vb: vb.slice() };
      canvas.classList.add('is-dragging');
    };
    const moveDrag = (x: number, y: number) => {
      if (!drag) return;
      const r = canvas.getBoundingClientRect();
      vb[0] = drag.vb[0] - ((x - drag.x) / r.width) * vb[2];
      vb[1] = drag.vb[1] - ((y - drag.y) / r.height) * vb[3];
      apply();
    };
    const endDrag = () => {
      drag = null;
      canvas.classList.remove('is-dragging');
    };

    canvas.addEventListener('pointerdown', (e) => {
      if (e.button === 0) startDrag(e.clientX, e.clientY);
    });
    window.addEventListener('pointermove', (e) => moveDrag(e.clientX, e.clientY));
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    // Un véritable glissement ne doit pas déclencher le lien du département.
    canvas.addEventListener(
      'click',
      (e) => {
        if (canvas.dataset.moved === '1') {
          e.preventDefault();
          canvas.dataset.moved = '0';
        }
      },
      true,
    );
    canvas.addEventListener('pointermove', () => {
      if (drag) canvas.dataset.moved = '1';
    });

    // --- Panneau d'information ---
    const fill = (kickerText: string, nom: string, texte: string, href: string) => {
      kicker.textContent = kickerText;
      pTitle.textContent = nom;
      pText.textContent = texte;
      pLink.setAttribute('href', href);
      pLink.textContent = `Voir ${nom}`;
    };

    root.querySelectorAll('[data-dep]').forEach((el) => {
      const show = () =>
        fill(
          `Département ${el.getAttribute('data-code') ?? ''}`,
          el.getAttribute('data-nom') ?? '',
          el.getAttribute('data-lede') ?? '',
          el.getAttribute('href') ?? '/zones-intervention',
        );
      el.addEventListener('mouseenter', show);
      el.addEventListener('focus', show);
    });

    root.querySelectorAll('[data-city]').forEach((el) => {
      const show = () =>
        fill(
          el.getAttribute('data-dep-nom') ?? '',
          el.getAttribute('data-nom') ?? '',
          'Page locale : contexte du bâti, problématiques rencontrées, prévention et questions fréquentes.',
          el.getAttribute('href') ?? '/zones-intervention',
        );
      el.addEventListener('mouseenter', show);
      el.addEventListener('focus', show);
    });
  }
</script>
