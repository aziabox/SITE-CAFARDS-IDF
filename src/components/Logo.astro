---
export interface Props { variant?: 'light' | 'dark'; class?: string }
const { variant = 'light', class: cls = '' } = Astro.props;
const ink = variant === 'light' ? '#FFFDF8' : '#571523';
const accent = variant === 'light' ? '#C77B45' : '#B4512C';
const sub = variant === 'light' ? 'rgba(255,253,248,0.66)' : 'rgba(74,66,61,0.85)';
---
<svg class={cls} width="152" height="34" viewBox="0 0 152 34" role="img" aria-label="Blattis, specialiste cafards et blattes en Île-de-France" focusable="false">
  <!-- Monogramme : ecusson d'hygiene, deux antennes stylisees -->
  <path d="M2 4.6C2 3.2 3.1 2.1 4.5 2.1h20.4c1.4 0 2.5 1.1 2.5 2.5v14.2c0 5.9-4.1 9.9-12.7 12.9C6.1 28.7 2 24.7 2 18.8V4.6Z" fill={ink} opacity="0.1"></path>
  <path d="M3.4 5.2c0-1 .8-1.8 1.8-1.8h19.2c1 0 1.8.8 1.8 1.8v13.5c0 5.3-3.7 9-11.4 11.7C7.1 27.7 3.4 24 3.4 18.7V5.2Z" fill="none" stroke={ink} stroke-width="1.6"></path>
  <path d="M10.6 11.2c1.3-1.5 2.6-2.3 4.1-2.3s2.8.8 4.1 2.3" fill="none" stroke={accent} stroke-width="1.6" stroke-linecap="round"></path>
  <rect x="11.5" y="13.4" width="6.4" height="9.4" rx="3.2" fill={ink}></rect>
  <path d="M8.2 24.6h13" stroke={accent} stroke-width="1.6" stroke-linecap="round"></path>
  <!-- Mot-marque -->
  <text x="37" y="17.4" font-family="Sora, system-ui, sans-serif" font-size="16.5" font-weight="700" letter-spacing="-0.6" fill={ink}>Blattis</text>
  <text x="37.5" y="28" font-family="Sora, system-ui, sans-serif" font-size="6.5" font-weight="600" letter-spacing="1.85" fill={sub}>CAFARDS &amp; BLATTES</text>
</svg>
