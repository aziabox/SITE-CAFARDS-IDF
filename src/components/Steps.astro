---
export interface Props {
  steps: Array<{ title: string; text: string }>;
  compact?: boolean;
}
const { steps, compact = false } = Astro.props;
---
<ol class={`steps${compact ? ' steps--compact' : ''}`}>
  {steps.map((s, i) => (
    <li>
      <span class="steps__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
<style>
  .steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
    grid-template-columns: repeat(auto-fit, minmax(258px, 1fr));
  }
  .steps > li {
    background: var(--surface);
    padding: clamp(1.3rem, 2.2vw, 1.8rem) clamp(1.3rem, 2vw, 1.6rem);
    position: relative;
  }
  .steps__num {
    display: block;
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.1em; color: var(--terra);
    margin-bottom: 0.85rem;
  }
  .steps h3 { font-size: 1.06rem; margin-bottom: 0.45rem; }
  .steps p { color: var(--ink-soft); font-size: 0.965rem; margin: 0; }
  .steps--compact > li { padding: 1.1rem 1.25rem; }
  .steps--compact h3 { font-size: 1rem; }
</style>
