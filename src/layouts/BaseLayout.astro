---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { graph, organizationSchema, websiteSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  /** Fil d'Ariane, sans l'élément « Accueil » qui est ajouté automatiquement. */
  breadcrumbs?: Array<{ label: string; href?: string }>;
  /** Nœuds JSON-LD additionnels (Service, FAQPage, Article...). */
  schema?: object[];
  /** Type Open Graph. */
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  breadcrumbs = [],
  schema = [],
  ogType = 'website',
  image = '/img/blattis-og.png',
  noindex = false,
  datePublished,
  dateModified,
  bodyClass = '',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : path + '/', site.url).href;
const ogImage = new URL(image, site.url).href;

const crumbItems = [{ label: 'Accueil', href: '/' }, ...breadcrumbs];
const hasCrumbs = breadcrumbs.length > 0;

const jsonLd = graph([
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    url: path,
    title,
    description,
    breadcrumbId: hasCrumbs ? canonical.replace(/\/$/, '/') + '#breadcrumb' : undefined,
    datePublished,
    dateModified,
  }),
  ...(hasCrumbs ? [breadcrumbSchema(path, crumbItems)] : []),
  ...schema,
]);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <meta name="theme-color" content="#571523" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="author" content={site.brand} />

    <link rel="preload" href="/fonts/sora-var-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-var-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenu">Aller au contenu principal</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      // Navigation mobile, en-tête compact et apparitions discrètes.
      // Ce script est regroupé par Astro dans un fichier externe : la politique
      // de sécurité du contenu peut donc rester en « script-src 'self' ».
      // « const » plutôt que « var » : indispensable pour que TypeScript
      // conserve le rétrécissement de type à l'intérieur des fermetures.
      const burger = document.querySelector('[data-burger]');
      const panel = document.getElementById('nav-mobile');

      if (burger && panel) {
        burger.addEventListener('click', () => {
          const open = burger.getAttribute('aria-expanded') === 'true';
          burger.setAttribute('aria-expanded', String(!open));
          panel.hidden = open;
          document.documentElement.classList.toggle('nav-open', !open);
        });

        panel.querySelectorAll('[data-sub-toggle]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!open));
            const id = btn.getAttribute('aria-controls');
            const list = id ? document.getElementById(id) : null;
            if (list) list.hidden = open;
          });
        });
      }

      const header = document.querySelector('[data-header]');
      if (header) {
        let tick = false;
        window.addEventListener(
          'scroll',
          () => {
            if (tick) return;
            tick = true;
            requestAnimationFrame(() => {
              header.classList.toggle('is-scrolled', window.scrollY > 24);
              tick = false;
            });
          },
          { passive: true },
        );
      }

      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
