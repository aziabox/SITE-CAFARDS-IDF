---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../content.config';
import { site } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const counts = Object.fromEntries(
  Object.keys(categories).map((k) => [k, posts.filter((p) => p.data.category === k).length]),
) as Record<string, number>;

const breadcrumbs = [{ label: 'Blog', href: '/blog' }];
const [featured, ...rest] = posts;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': new URL('/blog/', site.url).href + '#collection',
    name: 'Blog — cafards et blattes',
    description: "Articles sur l'identification, la prévention et le traitement des cafards et des blattes.",
    isPartOf: { '@id': new URL('/', site.url).href + '#site' },
  },
];
---

<BaseLayout
  title={`Blog cafards et blattes : guides et conseils | ${site.brand}`}
  description="Articles rédigés à partir de situations réellement rencontrées : identifier une espèce, évaluer une infestation, comprendre un traitement, prévenir une nouvelle installation."
  {breadcrumbs}
  {schema}
>
  <Hero
    label="Ressources"
    title="Comprendre et anticiper"
    text="Des articles rédigés à partir de situations réellement rencontrées sur le terrain, sans dramatisation ni raccourci. Chacun commence par une réponse directe à la question posée."
    bullets={[`${posts.length} articles`, '8 catégories', 'Réponses directes']}
    {breadcrumbs}
  />

  <section class="section section--tight">
    <div class="wrap">
      <nav class="cats" aria-label="Catégories du blog">
        {Object.entries(categories).map(([key, label]) =>
          counts[key] > 0 ? (
            <a href={`/blog/${key}`}>
              {label} <span>{counts[key]}</span>
            </a>
          ) : null,
        )}
      </nav>
    </div>
  </section>

  {featured && (
    <section class="section section--tight">
      <div class="wrap">
        <a class="feat" href={`/blog/${featured.id}`}>
          <div class="feat__body">
            <span class="card__meta">{categories[featured.data.category]} · Dernier article</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <span class="link-more" aria-hidden="true">Lire l’article</span>
          </div>
          <div class="feat__answer">
            <span class="answer__label">Réponse directe</span>
            <p>{featured.data.answer}</p>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Tous les articles</p>
        <h2>Articles récents</h2>
      </div>
      <div class="grid grid-3">
        {rest.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <CtaBand variant="creme" />
</BaseLayout>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .cats a {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.55rem 1rem;
    background: var(--surface); border: 1px solid var(--line-soft); border-radius: 999px;
    font-family: var(--font-display); font-size: 0.89rem; font-weight: 600;
    text-decoration: none; color: var(--bx-700);
  }
  .cats a:hover { border-color: var(--terra); color: var(--terra-600); }
  .cats span { font-size: 0.78rem; color: var(--ink-muted); font-weight: 400; }

  .feat {
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 0; text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line-soft); border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .feat:hover { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .feat__body { padding: clamp(1.4rem, 3vw, 2.15rem); }
  .feat__body h2 { font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.75rem); margin-bottom: 0.6rem; }
  .feat__body p { color: var(--ink-soft); margin-bottom: 0; }
  .feat__body .link-more { margin-top: 1.1rem; }
  .feat__answer {
    padding: clamp(1.4rem, 3vw, 2.15rem);
    background: var(--creme-2);
    border-left: 1px solid var(--line-soft);
  }
  .feat__answer p { margin: 0; font-size: 0.97rem; color: var(--ink); }
  @media (max-width: 820px) {
    .feat { grid-template-columns: 1fr; }
    .feat__answer { border-left: 0; border-top: 1px solid var(--line-soft); }
  }
</style>
