const related = [
  { label: 'Cafards en immeuble', href: '/cafards-immeuble', text: "Gaines, colonnes et circulation verticale." },
  { label: 'Cafards en appartement', href: '/cafards-appartement', text: "Ce qu'un occupant peut faire de son côté." },
  { label: 'Cafards en cave', href: '/cafards-cave', text: "Parties basses, humidité et locaux techniques." },
  { label: 'Traitement des cafards', href: '/traitement-cafards', text: "Méthode, inspection et définition du périmètre." },
  { label: 'Désinsectisation professionnelle', href: '/desinsectisation-cafards', text: "Traçabilité et plan de surveillance." },
  { label: "Zones d'intervention", href: '/zones-intervention', text: "Paris et les huit départements franciliens." },
